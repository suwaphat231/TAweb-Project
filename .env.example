# Docker Compose: use the same Web application client ID for frontend and backend.
GOOGLE_CLIENT_ID=
# Required: generate with python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Enable only when intentionally populating development/demo accounts and applications.
SEED_DEMO_DATA=false
# true = drop all tables and reseed on every backend start (dev only; requires DEV_LOGIN=true and SEED_DEMO_DATA=true)
RESET_DB_ON_START=false
MYSQL_HOST_PORT=3307
# Object storage (MinIO) for uploaded files. Required: generate with
# python -c "import secrets; print(secrets.token_hex(24))"
MINIO_ROOT_USER=labassist
MINIO_ROOT_PASSWORD=
# MinIO admin console, bound to localhost only: http://localhost:9001
MINIO_CONSOLE_PORT=9001
