# Required: generate with python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Enable only when intentionally populating development/demo accounts and applications.
SEED_DEMO_DATA=false
# Enables password-less /auth/dev-login for local development only.
DEV_LOGIN=false
# true = drop all tables and reseed on every backend start (dev only; requires DEV_LOGIN=true and SEED_DEMO_DATA=true)
RESET_DB_ON_START=false
PORT=8080
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=labassist
DB_PASSWORD=labassist123
DB_NAME=labassist

# SMTP for password-reset codes (e.g. Gmail: smtp.gmail.com / 587 / app password).
# Leave SMTP_HOST empty to disable; with DEV_LOGIN=true the code is logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
